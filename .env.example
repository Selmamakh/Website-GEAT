# ---------------------------------------------------------------------------
# Every value here is inlined into the JavaScript bundle at BUILD time and is
# readable by any visitor. NEVER put a secret in a VITE_* variable: this site
# is a static SPA with no server, so it cannot hold one. Anything that needs a
# credential must sit behind an endpoint that holds it server-side.
# ---------------------------------------------------------------------------

# Base URL of the GEAT HRIS public API.
# Public and unauthenticated - no credentials are sent with requests.
# REQUIRED in a production build: when unset, the code falls back to the
# localhost default below and every careers page reports a connection error.
VITE_API_BASE_URL=http://localhost:4000/api

# Full URL that receives contact-form submissions (JSON POST).
# Optional. While empty, the contact form tells the visitor that online
# submission is not active yet and points them at contact@geat.dz - it does
# NOT silently discard the message.
# e.g. https://hris.example.geat.dz/api/contact
VITE_CONTACT_ENDPOINT=

# Full URL that receives newsletter subscriptions (JSON POST).
# Optional, and behaves the same way when empty.
# Whatever sits behind it owns the consent lifecycle: confirmation email,
# double opt-in and unsubscribe links cannot be issued from the browser.
# e.g. https://hris.example.geat.dz/api/newsletter/subscribe
VITE_NEWSLETTER_ENDPOINT=
